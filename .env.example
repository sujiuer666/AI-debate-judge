# 环境变量键名参考（**程序不会自动读取 .env 文件**，也不会在界面收集密钥）
#
# 设置方式（启动 streamlit 之前）：
#   PowerShell:  $env:DEBATE_JUDGE_API_KEY="你的Key"
#   bash/zsh:    export DEBATE_JUDGE_API_KEY="你的Key"
#
# 不要把填好真实值的文件提交到任何仓库。

# 必填：LLM API Key（缺省时程序会在页面上提示，不弹输入框）
DEBATE_JUDGE_API_KEY=

# 选填：OpenAI 兼容接口地址（默认 https://api.openai.com/v1）
DEBATE_JUDGE_BASE_URL=

# 选填：模型名（默认 gpt-4o-mini）
DEBATE_JUDGE_MODEL=
