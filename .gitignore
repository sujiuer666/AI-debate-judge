# 虚拟环境与缓存
.venv/
__pycache__/
*.pyc
.pytest_cache/

# 本地导出的聊天记录 / 真实数据，绝不入库
samples/real_*.json
samples/*.json
!samples/sample_debate.txt

# 本地环境变量（虽然程序不读 .env，但避免误提交）
.env

# 网站部署（Streamlit Community Cloud / 本地 secrets）：密钥绝不入库
# 云端部署时 Secrets 在平台后台填写；本地开发可放 .streamlit/secrets.toml
.streamlit/
secrets.toml

# Node（Cloudflare Worker 自测 / wrangler CLI）
node_modules/
package-lock.json
